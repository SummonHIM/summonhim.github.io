---
import { timeline, type TimelineItem } from '../data/timeline'
import { tags } from '../data/tags'

type Group = { date: string; items: TimelineItem[] }

const groups = timeline.reduce<Group[]>((acc, item) => {
  const last = acc[acc.length - 1]
  if (last && last.date === item.date) {
    last.items.push(item)
  } else {
    acc.push({ date: item.date, items: [item] })
  }
  return acc
}, [])
---

<section id="about" class="about">
  <div class="container">
    <h2 class="section-title">关于我</h2>
    <ol class="timeline">
      {groups.map((group) => (
        <>
          <li
            class:list={{
              date: true,
              'is-hidden': group.items.every((i) => i.hidden),
            }}
          >
            {group.date}
          </li>
          {group.items.map((item) => (
            <li class:list={{ 'is-hidden': item.hidden }}>
              <h3>{item.title}</h3>
              <p data-unhide={item.unhide_description}>{item.description}</p>
            </li>
          ))}
        </>
      ))}
    </ol>
    <div class="tags">
      {tags.map((t) => (
        <span class="tag">{t}</span>
      ))}
    </div>
  </div>
</section>

<style>
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.25rem;
    border-left: 2px solid var(--border);
  }

  .timeline li {
    position: relative;
    padding: 0 0 1.5rem 1.5rem;
  }

  .timeline li.is-hidden {
    display: none;
  }

  .timeline li.date {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    width: fit-content;
    margin: 0 0 0.5rem 1.5rem;
    padding: 0.35rem 0.9rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid var(--accent);
    border-radius: 999px;
  }

  .timeline li.date::before {
    display: none;
  }

  .timeline li.date.is-hidden {
    display: none;
  }

  .timeline li::before {
    content: '';
    position: absolute;
    left: -1.55rem;
    top: 0.35rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
  }

  .timeline h3 {
    margin: 0 0 0.25rem;
    font-size: 1.05rem;
  }

  .timeline p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .tag {
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
</style>
