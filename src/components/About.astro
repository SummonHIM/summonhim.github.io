---
import { aboutIntro, serviceGroups } from '../data/about'
import { tags } from '../data/tags'
---

<section id="about" class="about">
  <div class="container">
    <h2 class="section-title">关于我</h2>
    <div class="intro">
      {aboutIntro.map((p) => (
        <p>{p}</p>
      ))}
    </div>
    <div class="stack">
      {serviceGroups.map((group) => (
        <div class="stack-group">
          <h3>{group.title}</h3>
          <ul>
            {group.items.map((item) => (
              <li>
                <span class="svc">{item.name}</span>
                <span class="note">{item.note}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="tags">
      {tags.map((t) => (
        <span class="tag">{t}</span>
      ))}
    </div>
  </div>
</section>

<style>
  .intro {
    margin-bottom: 2rem;
  }

  .intro p {
    margin: 0 0 0.75rem;
    color: var(--text-muted);
    text-wrap: balance;
  }

  .stack {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }

  .stack-group {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.25rem;
  }

  .stack-group h3 {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .stack-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .stack-group li {
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .svc {
    font-weight: 600;
    margin-right: 0.4rem;
  }

  .note {
    color: var(--text-muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .tag {
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .stack {
      grid-template-columns: 1fr;
    }
  }
</style>
