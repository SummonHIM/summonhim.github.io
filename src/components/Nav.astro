---
import ThemeToggle from './ThemeToggle.astro'
import Logo from './Logo.astro'
import { authentikUrl } from '../data/links'

const items = [
  { href: '#about', label: '关于' },
  { href: '#projects', label: '项目' },
]
---

<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href="#top">
      <Logo size={28} alt="SummonHIM" />
      <span class="brand-text">SummonHIM</span>
    </a>
    <nav class="links">
      {items.map((i) => (
        <a href={i.href}>{i.label}</a>
      ))}
      <a href={authentikUrl} target="_blank" rel="noopener">
        控制台
      </a>
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    z-index: 10;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
  }

  .brand-text {
    font-family: var(--font-brand);
    font-weight: normal;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .links a {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .links a:hover {
    color: var(--text);
  }
</style>
